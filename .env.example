# Nexus Agent — API keys
# Add MULTIPLE keys: when one hits a rate limit or dies, the agent switches
# automatically and tells you, instead of stopping.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=

# Optional extra providers (enable in config/config.yaml first)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# NEXUS_APPROVAL_MODE=smart     # smart | always | never
# NEXUS_THEME=cyber             # cyber | matrix | mono
# NEXUS_WORKSPACE=./workspace
# NEXUS_DEBUG=1
