# DeepSeek-Agent — environment options
#
# DeepSeek-Agent is a DEEPSEEK-NATIVE agent: it logs into chat.deepseek.com
# with your DeepSeek email + password and gets its own bearer token.
# No API key is needed. Put your credentials in at first run (the login
# wizard) — they're stored on-device only (chmod 600).
#
# Optional extra providers (enable in config/config.yaml first)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# DEEPSEEK_APPROVAL_MODE=smart     # smart | always | never
# DEEPSEEK_THEME=cyber             # cyber | matrix | mono
# DEEPSEEK_WORKSPACE=./workspace
# DEEPSEEK_DEBUG=1
